<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a1a"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🪙 CRYPTOCURRENCY WALLET 🪙"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Security Status -->
        <TextView
            android:id="@+id/security_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡️ Security Level: Checking..."
            android:textSize="14sp"
            android:textColor="#00FF00"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#2d2d2d"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Total Balance -->
        <TextView
            android:id="@+id/total_balance_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Portfolio Value: $0.00"
            android:textSize="18sp"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#2d2d2d"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Balances Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2d2d2d"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 Current Balances"
                android:textSize="16sp"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/balances_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Prices Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2d2d2d"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📈 Current Prices"
                android:textSize="16sp"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/prices_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/refresh_button"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="🔄 REFRESH PRICES"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#2196F3"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Send Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2d2d2d"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📤 Send Cryptocurrency"
                android:textSize="16sp"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Currency:"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/currency_spinner"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="#1a1a1a"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/current_balance_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Balance: 0.00000000"
                    android:textSize="12sp"
                    android:textColor="#00FF00" />

                <TextView
                    android:id="@+id/current_price_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Price: $0.00"
                    android:textSize="12sp"
                    android:textColor="#FFD700"
                    android:textAlignment="textEnd" />

            </LinearLayout>

            <EditText
                android:id="@+id/send_address_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Recipient address"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="#1a1a1a"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:inputType="text"
                android:maxLines="2" />

            <EditText
                android:id="@+id/send_amount_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Amount to send"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="#1a1a1a"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/private_key_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Private key for authorization"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="#1a1a1a"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:inputType="textPassword"
                android:maxLines="2" />

            <Button
                android:id="@+id/send_button"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="📤 SEND CRYPTOCURRENCY"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#4CAF50" />

        </LinearLayout>

        <!-- Receive Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2d2d2d"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📥 Receive Cryptocurrency"
                android:textSize="16sp"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/receive_button"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="📥 GENERATE RECEIVE ADDRESS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#9C27B0"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/receive_address_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:background="#1a1a1a"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/qr_code_image"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:background="#FFFFFF"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Swap Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2d2d2d"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔄 Cryptocurrency Swap"
                android:textSize="16sp"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="From:"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/swap_from_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="#1a1a1a" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="To:"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="4dp" />

                    <Spinner
                        android:id="@+id/swap_to_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="#1a1a1a" />

                </LinearLayout>

            </LinearLayout>

            <EditText
                android:id="@+id/swap_amount_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Amount to swap"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="#1a1a1a"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:inputType="numberDecimal" />

            <Button
                android:id="@+id/swap_button"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="🔄 SWAP CRYPTOCURRENCY"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#FF9800" />

        </LinearLayout>

        <!-- Transaction History -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2d2d2d"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Transaction History"
                android:textSize="16sp"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/export_history_button"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="📋 EXPORT TRANSACTION HISTORY"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#607D8B" />

        </LinearLayout>

        <!-- Progress Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2d2d2d"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/progress_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔄 Ready for operations..."
                android:textSize="14sp"
                android:textColor="#FFFF00"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:max="100"
                android:progress="0"
                android:progressTint="#FFD700" />

        </LinearLayout>

        <!-- Results Section -->
        <ScrollView
            android:id="@+id/results_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:visibility="gone"
            android:background="#2d2d2d"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/results_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <!-- Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🪙 Multi-Currency Wallet Features:\n• Support for 15+ major cryptocurrencies\n• Real-time price tracking and portfolio value\n• Secure send/receive with QR code generation\n• Cryptocurrency swapping with live exchange rates\n• Complete transaction history and export\n• Advanced security protection against threats\n\n🛡️ Security Features:\n• Anti-malware and anti-virus protection\n• Trojan detection and real-time monitoring\n• Encrypted data storage and secure transactions\n• Root/jailbreak detection and debugger protection\n• Network security monitoring and threat prevention"
            android:textSize="11sp"
            android:textColor="#888888"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>

